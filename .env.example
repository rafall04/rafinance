APP_NAME=Rafin
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Server selalu UTC. Timezone pengguna disimpan per-user di kolom users.timezone
# dan dipakai untuk menentukan booked_date (lihat aturan A10).
APP_TIMEZONE=UTC
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

RAFIN_DEFAULT_TIMEZONE=Asia/Jakarta
RAFIN_DEFAULT_CURRENCY=IDR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
#
# Dua role, sengaja dipisah (aturan A4):
#   rafin_app   — dipakai aplikasi. BUKAN pemilik tabel, tanpa BYPASSRLS,
#                 sehingga Row Level Security benar-benar berlaku baginya.
#   rafin_owner — pemilik skema, hanya dipakai migration. Melewati RLS.
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=rafin
DB_USERNAME=rafin_app
DB_PASSWORD=

DB_MIGRATE_USERNAME=rafin_owner
DB_MIGRATE_PASSWORD=

DB_TEST_DATABASE=rafin_test

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Dev di Windows memakai driver database: Horizon butuh ext-pcntl yang tidak
# ada di Windows. Produksi (Linux) memakai redis + Horizon — lihat README.
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="halo@rafin.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Masuk lewat Google
#
# Isi keduanya, dan tombol "Masuk dengan Google" muncul sendiri di halaman masuk
# dan daftar. Kosongkan salah satunya, tombolnya hilang — tanpa mengubah kode.
#
# Redirect URI yang didaftarkan di Google Cloud Console:
#   {APP_URL}/auth/google/callback
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Penyedia lain — sudah didukung, belum dipakai
#
# Biarkan kosong kalau belum dibutuhkan. Mengaktifkannya nanti cukup mengisi
# kredensial di sini; tidak ada kode yang perlu ditulis.
#
# Apple menuntut client_secret berupa JWT yang kedaluwarsa tiap enam bulan,
# bukan string tetap seperti Google — perlu perintah yang membuatnya ulang dari
# kunci .p8 sebelum benar-benar dipakai.
#
# Facebook TIDAK menjamin surel yang dikirimnya terverifikasi. Karena itu masuk
# lewat Facebook tidak pernah otomatis tersambung ke akun Rafin yang sudah ada
# dengan surel sama — pemiliknya harus masuk dengan kata sandi dulu, lalu
# menyambungkannya sendiri dari halaman Keamanan. Aturan itu yang mencegah
# pengambilalihan akun, dan ia diuji di tests/Security/OauthTest.php.
# ---------------------------------------------------------------------------
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Kanal Telegram (dipakai mulai FASE 2)
# Token bot TIDAK PERNAH ditulis di kode, komentar, test, atau commit.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=rafinanceid_bot
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Feature flag. Aturan A12: tidak ada LLM di jalur input utama.
# Keduanya wajib false sampai ada keputusan produk yang berbeda.
# ---------------------------------------------------------------------------
RAFIN_FEATURE_LLM_PARSER=false
RAFIN_FEATURE_OCR=false

VITE_APP_NAME="${APP_NAME}"
