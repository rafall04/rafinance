# Template .env produksi Rafin.
#
#   cp env.production.template /var/www/rafin/shared/.env
#   php artisan key:generate     # mengisi APP_KEY di tempat
#
# Setiap __ISI__ WAJIB diganti. Jangan pernah commit file hasilnya —
# .gitignore sudah menolak .env.production, tapi ini di server, bukan repo.

APP_NAME=Rafin
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://__DOMAIN__

# Server selalu UTC. Timezone pengguna per-user di kolom users.timezone (A10).
APP_TIMEZONE=UTC
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

RAFIN_DEFAULT_TIMEZONE=Asia/Jakarta
RAFIN_DEFAULT_CURRENCY=IDR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Produksi: level info, bukan debug. Harian dengan rotasi 14 hari.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database — dua role, sengaja dipisah (aturan A4)
#
#   rafin_app   dipakai aplikasi. BUKAN pemilik tabel, tanpa BYPASSRLS,
#               tanpa hak DDL. RLS benar-benar berlaku baginya.
#   rafin_owner pemilik skema, HANYA untuk migration. Melewati RLS.
#
# Password: bangkitkan dengan `openssl rand -base64 32`, berbeda untuk
# masing-masing role.
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=__DB_PORT__
DB_DATABASE=rafin
DB_USERNAME=rafin_app
DB_PASSWORD=__ISI_PASSWORD_APP__

DB_MIGRATE_USERNAME=rafin_owner
DB_MIGRATE_PASSWORD=__ISI_PASSWORD_OWNER__

# Tidak ada database test di produksi. Sengaja dikosongkan.
DB_TEST_DATABASE=

# ---------------------------------------------------------------------------
# Session, antrean, cache
#
# Berbeda dari dev: Linux punya ext-pcntl, jadi Redis dipakai penuh.
# SESSION_ENCRYPT=true karena session menyimpan konteks workspace.
# ---------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=__DOMAIN__
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=redis
CACHE_STORE=redis

BROADCAST_CONNECTION=log

# Lampiran di disk privat tanpa URL (aturan A11).
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=__ISI_PASSWORD_REDIS__
REDIS_PORT=__REDIS_PORT__
# Database Redis terpisah supaya tidak bentrok dengan project lain
# di instance yang sama.
REDIS_DB=0
REDIS_CACHE_DB=1

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=__ISI_SMTP_HOST__
MAIL_PORT=587
MAIL_USERNAME=__ISI__
MAIL_PASSWORD=__ISI__
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=__ISI_ALAMAT_PENGIRIM__
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Kanal Telegram
#
# Token bot TIDAK PERNAH ditulis di kode, komentar, test, atau commit.
# Ambil dari @BotFather, isi LANGSUNG di server, jangan lewat chat/tiket.
# Webhook wajib HTTPS dengan sertifikat tepercaya.
#
# Setelah diisi:
#   php artisan rafin:telegram:webhook --url=https://__DOMAIN__/webhooks/telegram
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=__ISI_DI_SERVER__
TELEGRAM_BOT_USERNAME=rafinanceid_bot
# openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=__ISI_DI_SERVER__

# ---------------------------------------------------------------------------
# Feature flag. Aturan A12: tidak ada LLM di jalur input utama.
# Keduanya WAJIB false sampai ada keputusan produk yang berbeda.
# ---------------------------------------------------------------------------
RAFIN_FEATURE_LLM_PARSER=false
RAFIN_FEATURE_OCR=false

VITE_APP_NAME="${APP_NAME}"
