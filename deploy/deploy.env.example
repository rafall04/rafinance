# Target deploy Rafin.
#
#   cp deploy/deploy.env.example deploy/deploy.env
#
# deploy/deploy.env ada di .gitignore dan tidak pernah ikut ter-commit.
# Alamat host internal sengaja tidak ditulis di repo publik: ia memetakan
# topologi jaringan bagi siapa pun yang membacanya, dan itu modal awal
# yang berguna kalau suatu saat ada pijakan lain di jaringan yang sama.

SSH_HOST=
SSH_USER=root
SSH_PORT=22

# Kunci privat untuk deploy. Bukan kunci pribadi Anda sehari-hari —
# buat khusus, supaya bisa dicabut sendiri tanpa mengganggu yang lain:
#   ssh-keygen -t ed25519 -f ~/.ssh/rafin_deploy -C 'deploy rafin'
#   ssh-copy-id -i ~/.ssh/rafin_deploy.pub -p 22 root@HOST
SSH_KEY="$HOME/.ssh/rafin_deploy"
